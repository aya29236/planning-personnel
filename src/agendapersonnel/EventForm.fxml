<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="agendapersonnel.EventFormController"
      styleClass="main-root"
      spacing="0">

    <!-- HEADER -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="0" right="16" bottom="0" left="16"/></padding>
        <Label text="🌸" styleClass="top-deco"/>
        <Label fx:id="formTitle" text="✨ Nouvel événement"
               styleClass="top-title"/>
    </HBox>

    <!-- BODY -->
    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <padding><Insets top="18" right="24" bottom="10" left="24"/></padding>

        <!-- Titre -->
        <VBox spacing="4">
            <Label text="Titre *" styleClass="section-label"/>
            <TextField fx:id="titleField"
                       promptText="Ex: Réunion de projet, Anniversaire..."
                       styleClass="prenom-field"/>
        </VBox>

        <!-- Date + Heure -->
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Date *" styleClass="section-label"/>
                <DatePicker fx:id="datePicker"
                            styleClass="prenom-field"
                            maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" prefWidth="130">
                <Label text="Heure" styleClass="section-label"/>
                <TextField fx:id="timeField"
                           promptText="09:30"
                           styleClass="prenom-field"/>
            </VBox>
        </HBox>

        <!-- Type + Priorité -->
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Type *" styleClass="section-label"/>
                <ComboBox fx:id="typeCombo"
                          maxWidth="Infinity"
                          styleClass="prenom-field"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Priorité" styleClass="section-label"/>
                <ComboBox fx:id="priorityCombo"
                          maxWidth="Infinity"
                          styleClass="prenom-field"/>
            </VBox>
        </HBox>

        <!-- Description -->
        <VBox spacing="4" VBox.vgrow="ALWAYS">
            <Label text="Description" styleClass="section-label"/>
            <TextArea fx:id="descArea"
                      promptText="Notes, lieu, détails supplémentaires..."
                      styleClass="prenom-field"
                      prefHeight="90"
                      wrapText="true"/>
        </VBox>

        <!-- Rappel -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <CheckBox fx:id="reminderCheck"
                      text="Rappel avant l'événement"
                      styleClass="section-label"/>
            <ComboBox fx:id="reminderCombo"
                      styleClass="prenom-field"
                      prefWidth="130"/>
        </HBox>

        <!-- Message d'erreur -->
        <Label fx:id="errorLabel"
               text=""
               styleClass="error-label"
               wrapText="true"/>

    </VBox>

    <!-- FOOTER -->
    <HBox styleClass="statusbar" alignment="CENTER_RIGHT" spacing="10">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
        <Button fx:id="cancelBtn"
                text="Annuler"
                styleClass="nav-btn"
                onAction="#handleCancel"/>
        <Button fx:id="saveBtn"
                text="Enregistrer ✓"
                styleClass="add-btn"
                prefWidth="150"
                onAction="#handleSave"
                defaultButton="true"/>
    </HBox>

</VBox>