<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="agendapersonnel.StatsController"
      styleClass="main-root"
      spacing="0"
      prefWidth="600" prefHeight="560">

    <!-- HEADER -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="0" right="16" bottom="0" left="16"/></padding>
        <Label text="📊" styleClass="top-deco"/>
        <Label text="Statistiques de mon agenda" styleClass="top-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Rafraîchir"
                styleClass="theme-toggle-btn"
                onAction="#handleRefresh"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                styleClass="events-scroll">
        <VBox spacing="14">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <!-- COMPTEURS -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <!-- Total -->
                <VBox styleClass="event-card" alignment="CENTER" spacing="4"
                      GridPane.columnIndex="0">
                    <padding><Insets top="12" right="8" bottom="12" left="8"/></padding>
                    <Label fx:id="totalLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #d4537e;"/>
                    <Label text="Total" styleClass="event-meta"/>
                </VBox>

                <!-- Complétés -->
                <VBox styleClass="event-card" alignment="CENTER" spacing="4"
                      GridPane.columnIndex="1">
                    <padding><Insets top="12" right="8" bottom="12" left="8"/></padding>
                    <Label fx:id="completedLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1d9e75;"/>
                    <Label text="Complétés" styleClass="event-meta"/>
                </VBox>

                <!-- À venir -->
                <VBox styleClass="event-card" alignment="CENTER" spacing="4"
                      GridPane.columnIndex="2">
                    <padding><Insets top="12" right="8" bottom="12" left="8"/></padding>
                    <Label fx:id="upcomingLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ef9f27;"/>
                    <Label text="À venir" styleClass="event-meta"/>
                </VBox>

                <!-- Priorité haute -->
                <VBox styleClass="event-card" alignment="CENTER" spacing="4"
                      GridPane.columnIndex="3">
                    <padding><Insets top="12" right="8" bottom="12" left="8"/></padding>
                    <Label fx:id="highPrioLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e24b4a;"/>
                    <Label text="Priorité haute" styleClass="event-meta"/>
                </VBox>
            </GridPane>

            <!-- INFOS RAPIDES -->
            <HBox spacing="10">
                <VBox styleClass="event-card" spacing="4" HBox.hgrow="ALWAYS">
                    <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                    <Label text="📅 Mois le plus chargé"
                           styleClass="section-title"/>
                    <Label fx:id="mostBusyLabel" text="—"
                           styleClass="event-meta"/>
                </VBox>
                <VBox styleClass="event-card" spacing="4" HBox.hgrow="ALWAYS">
                    <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                    <Label text="✅ Taux de complétion"
                           styleClass="section-title"/>
                    <Label fx:id="completionRateLabel" text="0%"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1d9e75;"/>
                </VBox>
            </HBox>

            <!-- GRAPHE PAR TYPE -->
            <VBox styleClass="event-card" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Répartition par type" styleClass="section-title"/>
                <VBox fx:id="typeChartBox" spacing="6"/>
            </VBox>

            <!-- GRAPHE PAR PRIORITÉ -->
            <VBox styleClass="event-card" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Répartition par priorité" styleClass="section-title"/>
                <VBox fx:id="prioChartBox" spacing="6"/>
            </VBox>

            <!-- GRAPHE PAR MOIS -->
            <VBox styleClass="event-card" spacing="8">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                <Label text="Activité par mois (top 6)" styleClass="section-title"/>
                <VBox fx:id="monthChartBox" spacing="6"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
