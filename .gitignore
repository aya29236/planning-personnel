# Build output (regenerated by Clean and Build)
build/
dist/
*.class

# NetBeans per-user files (contain local paths)
nbproject/private/

# Libraries: download them, don't commit them
lib/*.jar
!lib/CopyLibs/

# Local runtime data (never commit)
agenda_prefs.properties
db.properties

# OS / editor
.DS_Store
Thumbs.db
*.log
